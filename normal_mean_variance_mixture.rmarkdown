eval_points <- 
  expand_grid(x11 = seq(-2, 6, length.out = 150),
              x21 = seq(-2, 6, length.out = 150))

skewt_density <-
  eval_points |> 
  rowwise() |> 
  mutate(density = dtskewt(c(x11, x21), 
                           mu = c(1, 2), sigmas = list(s1), skew = c(2, 1), 
                           nu = 20))

ggplot(skewt_density, aes(x = x11, y = x21, fill = density)) +
  geom_raster() +
  scale_fill_viridis_c() +
  coord_fixed() +
  labs(x = "X[1, 1]", y = "X[2, 1]", fill = "density") +
  theme_minimal()
```

